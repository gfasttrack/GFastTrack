# Neon connection string (Postgres). Render and Neon both accept this name.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Any long random string. Render can generate this for you.
SECRET_KEY=change-me

# Cloudinary dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared secret the ESP32 sends as the X-Device-Key header.
# Leave empty only on your own computer.
DEVICE_INGEST_KEY=

# Comma-separated sites that may call this API.
# Example: https://yourname.github.io
# Use * while you are testing.
FRONTEND_ORIGINS=*

# Clock used for history labels. The design is set in Accra.
APP_TIMEZONE=Africa/Accra

# Admin website at /admin. Change these before you put the site online.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Address the ESP32 can reach. Leave empty to use the address you opened in the browser.
# Example: https://your-app.onrender.com
PUBLIC_BASE_URL=
